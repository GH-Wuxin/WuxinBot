{
  "name": "qq-ai-chatbot",
  "version": "1.0.3",
  "description": "A friendly QQ group chat AI bot with a Chinese GUI control panel.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web\"",
    "server": "tsx watch server/index.ts",
    "web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm run sanity && npm run security && npm run search:verify && npm run search:agent:verify && npm run agent:v2:verify && npm run osu:roast:verify && npm run osu:analyze-disabled:verify && npm run runtime:safety:verify && npm run request:trace:verify",
    "start": "tsx server/index.ts",
    "sanity": "tsx tools/sanity.mjs",
    "security": "tsx tools/security-verify.mjs",
    "search:verify": "node --import tsx tools/search-security-verify.mjs",
    "search:agent:verify": "node --import tsx tools/search-agent-loop-verify.mjs",
    "runtime:safety:verify": "node --import tsx tools/runtime-safety-verify.mjs",
    "request:trace:verify": "node --import tsx tools/request-trace-verify.mjs",
    "osu:roast:verify": "node --import tsx tools/osu-one-line-review-verify.mjs",
    "osu:analyze-disabled:verify": "node --import tsx tools/osu-analyze-disabled-verify.mjs",
    "structure": "node tools/structure-report.mjs",
    "verify-all": "node tools/run-all-verifies.mjs",
    "agent:replay": "node --import tsx tools/agent-replay.ts",
    "agent:campaign:c1": "node --import tsx tools/agent-runtime-campaign.ts",
    "agent:campaign:c2": "node --import tsx tools/agent-runtime-c2-campaign.ts",
    "agent:counterfactual": "node --import tsx tools/agent-counterfactual.ts",
    "agent:v2:verify": "node --import tsx tools/agent-runtime-v2-contract-verify.mjs && node --import tsx tools/agent-runtime-v2-process-verify.mjs && node --import tsx tools/skill-profiler-agent-verify.mjs && node --import tsx tools/skill-profiler-commands-verify.mjs && node --import tsx tools/skill-profiler-card-verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.16.0",
    "openai": "^6.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.22.3"
  }
}
