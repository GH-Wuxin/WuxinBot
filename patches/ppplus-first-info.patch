+package me.aloic.lazybotppplus.service;
+
+import jakarta.annotation.PreDestroy;
+import me.aloic.lazybotppplus.entity.vo.PlayerStats;
+import me.aloic.lazybotppplus.exception.InvalidScoreException;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Service;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+
+/** Short HTTP requests observe a single, bounded calculation per player. */
+@Service
+public class PlayerJobService {
+    private static final Logger logger = LoggerFactory.getLogger(PlayerJobService.class);
+    private static final long SUCCESS_TTL_MS = 30 * 60_000L;
+    private static final long FAILURE_TTL_MS = 15_000L;
+    private static final int MAX_JOBS = 256;
+    private final PlayerService players;
+    private final Map<Long, Job> jobs = new HashMap<>();
+    private final ThreadPoolExecutor executor = new ThreadPoolExecutor(
+            2, 2, 0, TimeUnit.MILLISECONDS, new ArrayBlockingQueue<>(64),
+            Thread.ofPlatform().name("ppplus-player-job-", 0).daemon().factory());
+
+    public PlayerJobService(PlayerService players) { this.players = players; }
+
+    public record Snapshot(Long id, String status, PlayerStats result, String errorCode) {}
+    private static class Job {
+        final Long id;
+        volatile Snapshot snapshot;
+        volatile long finishedAt;
+        Job(Long id) { this.id = id; snapshot = new Snapshot(id, "queued", null, null); }
+        boolean expired(long now) {
+            return finishedAt > 0 && now - finishedAt >
+                    ("completed".equals(snapshot.status()) ? SUCCESS_TTL_MS : FAILURE_TTL_MS);
+        }
+    }
+
+    public synchronized Snapshot start(Long id, boolean refresh) {
+        if (id == null || id <= 0) throw new IllegalArgumentException("Invalid player id");
+        long now = System.currentTimeMillis();
+        jobs.values().removeIf(job -> job.expired(now));
+        Job existing = jobs.get(id);
+        if (existing != null && (!refresh || existing.finishedAt == 0)) return existing.snapshot;
+        if (existing == null && jobs.size() >= MAX_JOBS) {
+            // Evict only finished results; never lose ownership of active work.
+            jobs.values().stream().filter(job -> job.finishedAt > 0)
+                    .min(java.util.Comparator.comparingLong(job -> job.finishedAt))
+                    .ifPresent(job -> jobs.remove(job.id));
+            if (jobs.size() >= MAX_JOBS) return new Snapshot(id, "failed", null, "QUEUE_FULL");
+        }
+        Job job = new Job(id);
+        jobs.put(id, job);
+        try {
+            executor.execute(() -> {
+                job.snapshot = new Snapshot(id, "running", null, null);
+                try {
+                    PlayerStats result = refresh ? players.updatePlayerStats(id) : players.getPlayerStats(id);
+                    job.snapshot = new Snapshot(id, "completed", result, null);
+                } catch (Exception error) {
+                    logger.error("PP+ player job {} failed", id, error);
+                    job.snapshot = new Snapshot(id, "failed", null,
+                            error instanceof InvalidScoreException ? "NO_SCORES" : "CALCULATION_FAILED");
+                } finally {
+                    job.finishedAt = System.currentTimeMillis();
+                }
+            });
+        } catch (java.util.concurrent.RejectedExecutionException error) {
+            jobs.remove(id, job);
+            return new Snapshot(id, "failed", null, "QUEUE_FULL");
+        }
+        return job.snapshot;
+    }
+
+    public synchronized Snapshot status(Long id) {
+        Job job = jobs.get(id);
+        return job == null ? null : job.snapshot;
+    }
+
+    @PreDestroy
+    public void close() { executor.shutdownNow(); }
+}
