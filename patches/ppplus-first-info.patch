+package me.aloic.lazybotppplus.util;
+
+import org.junit.jupiter.api.Test;
+import java.io.IOException;
+import java.util.concurrent.DelayQueue;
+import static org.junit.jupiter.api.Assertions.*;
+
+class AssertDownloadUtilTest {
+    @Test void failedDownloadsKeepTheirRateLimitPermits() throws Exception {
+        var field = AssertDownloadUtil.class.getDeclaredField("delayQueue");
+        field.setAccessible(true);
+        var queue = (DelayQueue<?>) field.get(null);
+        int permits = queue.size();
+        for (int i = 0; i < 8; i++) {
+            assertThrows(IOException.class, () -> AssertDownloadUtil.withDownloadPermit(() -> {
+                throw new IOException("simulated download failure");
+            }));
+            assertEquals(permits, queue.size(), "failures must not permanently consume permits");
+        }
+        AssertDownloadUtil.withDownloadPermit(() -> null);
+        assertEquals(permits, queue.size());
+    }
+}
