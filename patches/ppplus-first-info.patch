+package me.aloic.lazybotppplus.service;
+
+import me.aloic.lazybotppplus.entity.vo.PlayerStats;
+import me.aloic.lazybotppplus.entity.vo.PPPlusPerformance;
+import me.aloic.lazybotppplus.exception.InvalidScoreException;
+import org.junit.jupiter.api.Test;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+class PlayerJobServiceTest {
+    private static PlayerJobService.Snapshot finished(PlayerJobService jobs, long id) throws Exception {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (System.nanoTime() < deadline) {
+            var state = jobs.status(id);
+            if (state != null && (state.status().equals("completed") || state.status().equals("failed"))) return state;
+            Thread.sleep(5);
+        }
+        fail("job did not finish");
+        return null;
+    }
+
+    @Test void pollingDoesNotStartWorkAndRepeatedStartsShareSlowJob() throws Exception {
+        PlayerService players = mock(PlayerService.class);
+        CountDownLatch release = new CountDownLatch(1);
+        when(players.getPlayerStats(1L)).thenAnswer(call -> {
+            assertTrue(release.await(3, TimeUnit.SECONDS));
+            return new PlayerStats(1L, new PPPlusPerformance());
+        });
+        PlayerJobService jobs = new PlayerJobService(players);
+        try {
+            assertNull(jobs.status(1L));
+            verifyNoInteractions(players);
+            for (int i = 0; i < 20; i++) assertNotEquals("completed", jobs.start(1L, false).status());
+            release.countDown();
+            assertNotNull(finished(jobs, 1L).result());
+            assertEquals("completed", jobs.start(1L, false).status());
+            verify(players, times(1)).getPlayerStats(1L);
+        } finally { release.countDown(); jobs.close(); }
+    }
+
+    @Test void limitsWorkAndDistinguishesNoScoresFromCalculationFailure() throws Exception {
+        PlayerService players = mock(PlayerService.class);
+        AtomicInteger active = new AtomicInteger();
+        AtomicInteger maximum = new AtomicInteger();
+        CountDownLatch entered = new CountDownLatch(2);
+        CountDownLatch release = new CountDownLatch(1);
+        when(players.getPlayerStats(anyLong())).thenAnswer(call -> {
+            int current = active.incrementAndGet();
+            maximum.accumulateAndGet(current, Math::max);
+            entered.countDown();
+            try {
+                assertTrue(release.await(3, TimeUnit.SECONDS));
+                long id = call.getArgument(0);
+                if (id == 3) throw new InvalidScoreException("no scores");
+                if (id == 4) throw new IllegalStateException("private internal detail");
+                return new PlayerStats(id, new PPPlusPerformance());
+            } finally { active.decrementAndGet(); }
+        });
+        PlayerJobService jobs = new PlayerJobService(players);
+        try {
+            for (long i = 1; i <= 10; i++) jobs.start(i, false);
+            assertTrue(entered.await(2, TimeUnit.SECONDS));
+            assertEquals(2, maximum.get());
+            assertEquals("queued", jobs.status(10L).status());
+            release.countDown();
+            assertEquals("NO_SCORES", finished(jobs, 3L).errorCode());
+            assertEquals("CALCULATION_FAILED", finished(jobs, 4L).errorCode());
+            assertEquals("completed", finished(jobs, 10L).status());
+            assertEquals(2, maximum.get());
+        } finally { release.countDown(); jobs.close(); }
+    }
+}
