{
  "schema_version": "rewrite_telemetry_v1",
  "collection": "db.usageEvents (kind='rewrite-reply')",
  "retention": "latest 5000 usageEvents (existing cap)",
  "privacy_policy": "no full plaintext; only sha256(originalText)/sha256(rewrittenText), char counts, ids and usage/latency/result",
  "fields": {
    "id": "uuid",
    "kind": "rewrite-reply",
    "eventType": "group|private|unknown",
    "messageId": "correlation: incoming OneBot message id (optional)",
    "turnId": "correlation: processIncoming turn id (optional)",
    "groupId": "optional",
    "userId": "optional",
    "eligible": "bool: isWeirdReply(replyText)",
    "invoked": "bool: rewriteNormalReply actually called",
    "skipReason": "long_form | direct_tool_delivery | identity_question_deterministic | null",
    "provider": "provider name from LLM response when available",
    "model": "model name from LLM response when available",
    "inputTokens": "prompt_tokens || input_tokens; null when unavailable",
    "outputTokens": "completion_tokens || output_tokens; null when unavailable",
    "cachedInputTokens": "prompt_tokens_details.cached_tokens || input_tokens_details.cached_tokens; null when unavailable",
    "usageAvailable": "bool: at least one real token number present",
    "latencyMs": "number|null (SKIPPED records null)",
    "result": "SKIPPED|UNCHANGED|CHANGED|ERROR_FALLBACK|EMPTY_FALLBACK|TIMEOUT_FALLBACK|OTHER_FALLBACK",
    "originalChars": "number",
    "rewrittenChars": "number",
    "contentChanged": "bool: deterministic trim/newline/whitespace normalization comparison, no LLM",
    "originalHash": "sha256(originalText)",
    "rewrittenHash": "sha256(rewrittenText)",
    "createdAt": "ISO timestamp"
  },
  "failure_contract": "recordRewriteTelemetry catches all write errors and returns false; the user reply is never affected",
  "no_extra_llm_call": true
}
