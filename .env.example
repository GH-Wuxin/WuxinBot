# ── LLM provider ──
# deepseek, openai-compatible, or codex-app-server.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional secondary providers
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MIMO_API_BASE_URL=

# Optional personal ChatGPT / Codex App Server transport.
# The GUI can set these fields; auth remains in the official Codex credential store.
CODEX_EXECUTABLE=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_TIMEOUT_MS=90000

# ── Server / admin ──
ADMIN_PASSWORD=
PORT=8787
# Runtime data directory. Defaults to %APPDATA%\Wuxin on Windows.
DATA_DIR=

# Canonical production root after a local migration; DATA_DIR remains the
# per-process override for isolated tests. Legacy AppData is also protected.
WUXIN_PRODUCTION_DATA_DIR=

# Optional explicit Oracle predictor location and Python executable.
OSU_ORACLE_SCRIPT=
OSU_ORACLE_PYTHON=

# Desktop launch environment (set before starting Electron; use a launch script).
# Junction aliases are resolved so all shortcuts use the same single-instance lock.
WUXIN_DESKTOP_DATA_DIR=
WUXIN_DESKTOP_START_HIDDEN=0
WUXIN_DESKTOP_START_ALL=0

# ── osu! API (required for /w osu analyze, recent, recommend, match, ...) ──
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_API_BASE_URL=https://osu.ppy.sh/api/v2
OSU_TOKEN_URL=https://osu.ppy.sh/oauth/token

# Maximum number of map analyses the bot may have in flight at once.
# Keep this aligned with the local profiler's --analysis-workers setting.
SKILL_PROFILER_CONCURRENCY=6

# ── External bots bridge (optional; only needed when using the original
#    Yumu/Kanon/Hydrant/LazyBot binaries next to Wuxin) ──
# Root of the external bots deployment; the default is ./external-bots.
BOTS_ROOT=
# Optional per-file overrides
LAZYBOT_CONFIG_PATH=
HYDRANT_CONFIG_PATH=
GROUP_BOT_CONFIG_PATH=
# Bridge self id used for non-yumu bot sessions (fake by default)
BRIDGE_SELF_ID=

# ── NapCat / renderer paths (used by tools/*.ps1 helpers) ──
NAPCAT_SHELL_DIR=
NAPCAT_USER_DATA_DIR=
# Optional; auto-detects NapCatWinBootMain*.exe when empty.
NAPCAT_LAUNCHER_NAME=
YUMU_NODE=
YUMU_DIR=

# ── Knowledge base (default off; see docs/KNOWLEDGE_BASE_V41.md) ──
KB_ENABLED=false
